# Copy to .env and fill in. Never commit .env.

# --- eClass (Moodle) ---------------------------------------------------------
ECLASS_URL=https://eclass.yorku.ca
# Filled in for you by: python scripts/get_eclass_token.py
ECLASS_TOKEN=
# Which courses to include: inprogress | all | future | past
COURSE_CLASSIFICATION=inprogress
# Comma-separated text; any course whose name/shortname contains one is skipped
EXCLUDE_COURSES=

# --- Email -------------------------------------------------------------------
# Where the digest goes (e.g. your @my.yorku.ca address)
DIGEST_TO=
# smtp = send from your Gmail with an app password (README step 3)
# gmail_api = send via scripts/google_login.py instead
EMAIL_METHOD=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Your Gmail address
SMTP_USER=
# The 16-character Gmail app password (not your normal password)
SMTP_PASSWORD=
EMAIL_FROM=
# Also send a short email whenever deadlines are added, moved or removed on your calendar
NOTIFY_CALENDAR_CHANGES=true
# Send an email even on days with nothing new (deadlines are still listed)
SEND_IF_NOTHING_NEW=true
# Append a full per-course index of every resource to each email
INCLUDE_FULL_INDEX=true

# --- AI summary (optional, free) ---------------------------------------------
# A free Gemini key from https://aistudio.google.com/apikey (no card needed).
# On the free tier, Google may use what's sent (course text) to improve its products.
# auto = on when GEMINI_API_KEY is set; on; off
AI_SUMMARY=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded or out of free quota
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash

# --- Google Calendar ---------------------------------------------------------
# Robot account key from Google Cloud (README step 3)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# The Calendar ID of the calendar you shared with the robot account
# (looks like abc123...@group.calendar.google.com)
GCAL_CALENDAR_ID=
# Only for the alternative scripts/google_login.py sign-in:
GOOGLE_CLIENT_SECRETS=credentials.json
GOOGLE_TOKEN_FILE=token.json
GCAL_CALENDAR_NAME=YorkU eClass
# How far ahead to sync eClass calendar events
LOOKAHEAD_DAYS=120
# "Due soon" window shown at the top of the email
DEADLINE_WINDOW_DAYS=14
TIMEZONE=America/Toronto

# --- Local copies of course files (optional) ---------------------------------
DOWNLOAD_FILES=false
DOWNLOAD_DIR=downloads
